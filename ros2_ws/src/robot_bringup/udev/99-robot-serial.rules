# Both the ESP32 and the RPLIDAR use the same Silicon Labs CP210x chip
# (idVendor=10c4, idProduct=ea60) and even share the same generic factory
# serial number (0001), so neither vendor:product nor serial can tell them
# apart. Pin each symlink to its physical USB hub port instead -- stable
# across reboots/replugs, only changes if a cable is moved to a different
# port.
#
# Confirmed via: udevadm info -q property -p /sys/class/tty/ttyUSBx | grep ID_PATH

SUBSYSTEM=="tty", IMPORT{builtin}="path_id", ENV{ID_PATH}=="platform-3610000.usb-usb-0:2.1:1.0", SYMLINK+="rplidar", MODE="0666"
SUBSYSTEM=="tty", IMPORT{builtin}="path_id", ENV{ID_PATH}=="platform-3610000.usb-usb-0:2.4:1.0", SYMLINK+="esp32", MODE="0666"
